# =============================================================================
# YourTravelGuide — Environment Variables (TEMPLATE)
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# Every variable here is validated at boot by `lib/env.ts` (Zod). A missing or
# malformed value fails the build/start fast — we never run half-configured.
# =============================================================================

# --- Public application metadata (safe to expose to the browser) -------------
# Canonical site origin, no trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# One of: development | preview | production
NEXT_PUBLIC_APP_ENV="development"

# --- Supabase (public) -------------------------------------------------------
# Project URL and anon key are public by design (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# --- Supabase (server-only secrets) ------------------------------------------
# Service role key bypasses RLS — server only, NEVER prefixed NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# --- Database (server-only) --------------------------------------------------
# Pooled connection string for the app (Supabase "Transaction" pooler, 6543).
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:6543/postgres"
# Direct connection for migrations (Supabase "Session" pooler / direct, 5432).
DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# --- Observability (optional; abstraction no-ops when unset) ------------------
# Sentry DSN — leave blank to disable error tracking locally.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
